# Optional local Vault KV v2 configuration. When VAULT_ADDR and VAULT_TOKEN
# are set, `pnpm dev` loads the remaining variables from this Vault path.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=hvs...
VAULT_SECRET_PATH=secret/dapur-buwikra-fe-local

# Central OIDC/SSO service
AUTH_URL=http://localhost:3001
AUTH_CLIENT_ID=your-central-oauth-client-id
AUTH_CLIENT_SECRET=your-central-oauth-client-secret

# Better Auth — this app's OWN auth database (never shared with other apps
# or the central auth service). Local dev: dapur_auth_dev.
BETTER_AUTH_SECRET=your-better-auth-secret
DATABASE_URL=postgresql://user:password@localhost:5432/dapur_auth_dev

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NODE_ENV=development
